# Supabase public client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-side aliases accepted by backend/scripts.
# Browser/client code still needs the NEXT_PUBLIC_* names above.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only Supabase key used for cache writes, telemetry, seed/embed scripts
SUPABASE_SERVICE_ROLE_KEY=

# AI generation.
# Use AI Gateway/Vercel OIDC in production when available, or provider keys locally.
# Without paid keys, the backend can use Pollinations as a free demo provider.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_REASONING_MODEL=openai/gpt-5-mini
AI_BARGAIN_MODEL=openai/gpt-5-mini
AI_FREE_PROVIDER=pollinations
AI_DISABLE_FREE_PROVIDER=0
AI_ENABLE_FREE_SOURCE_AI=0
POLLINATIONS_BASE_URL=https://text.pollinations.ai
POLLINATIONS_MODEL=openai-fast

# Embeddings for pgvector supplier retrieval
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Force deterministic fallback mode for demos or offline development
AI_DISABLE_LLM=0
